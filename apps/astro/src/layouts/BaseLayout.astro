---
import "../styles/main.scss";
import "@splidejs/splide/css";
import ClientRouter from "astro/components/ClientRouter.astro";
import { Font } from "astro:assets";
import Navigation from "../components/Navigation.astro";

const requestUrl = new URL(Astro.request.url);
const increaseBreakoutWidth = requestUrl.pathname === "/creations" || requestUrl.pathname === "/creations/" ;

const slideOutIn = {
  old: {
    name: "slideOut",
    duration: "0.4s",
    easing: "ease-in",
    direction: "reverse",
  },
  new: {
    name: "slideIn",
    duration: "0.4s",
    delay: "0.4s",
    easing: "ease-in-out",
  },
};

const pageTransition = {
  forwards: slideOutIn,
  backwards: slideOutIn,
};
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <Font cssVariable="--font-inter" />
    <Font cssVariable="--font-proxima-nova" />
    <ClientRouter />
    <title>{requestUrl.pathname}</title>
  </head>

  <body>
    <header class="navigation-wrapper app-header content-grid">
      <Navigation />
    </header>

    <main
      transition:animate={pageTransition}
      class:list={[
        "content-grid",
        { "increased-breakout-width": increaseBreakoutWidth },
      ]}
    >
      <slot />
    </main>
  </body>
</html>

<style is:global>
  main {
    margin-top: 110px;
  }

  @keyframes slideOut {
    0% {
      opacity: 0;
      transform: translateX(-40px);
    }
    100% {
      transform: translateX(0);
      opacity: 1;
    }
  }

  @keyframes slideIn {
    0% {
      opacity: 0;
      transform: translateX(40px);
    }
    100% {
      opacity: 1;
      transform: translateX(0);
    }
  }
</style>

<script>
  const sameContentRoutes = ["/", "/creations"];

  function isSameContentRoute(from: string, to: string) {
    return (
      (sameContentRoutes.includes(from) && sameContentRoutes.includes(to)) ||
      from === to
    );
  }

  let lastScrollPosition = 0;
  const navBar = document.querySelector(".navigation-wrapper .menu-button");
  const popover = document.getElementById("mobile-nav-menu");

  const onScroll = () => {
    const currentScrollPosition =
      window.pageYOffset || document.documentElement.scrollTop;
    if (currentScrollPosition < 0) {
      return;
    }

    if (Math.abs(currentScrollPosition - lastScrollPosition) < 60) {
      return;
    }

    if (currentScrollPosition < lastScrollPosition) {
      navBar?.classList.add("show");
      navBar?.classList.remove("hide");
    } else {
      navBar?.classList.add("hide");
      navBar?.classList.remove("show");
      popover?.hidePopover();
    }

    lastScrollPosition = currentScrollPosition;
  };

  window.addEventListener("scroll", onScroll);

  document.addEventListener(
    "click",
    (e) => {
      const anchor = e?.target?.closest("a");
      if (!anchor) return;

      const href = anchor.getAttribute("href");
      if (!href) return;

      const current = window.location.pathname;
      const target = new URL(href, window.location.origin).pathname;

      if (isSameContentRoute(current, target)) {
        console.log("isSameContent");
        e.preventDefault(); // stop Astro router
        // e.stopImmediatePropagation();

        if (current !== target) {
          window.history.pushState({ state: target }, "", target); // just update URL
        }
      }
    },
    { capture: true },
  );

  window.addEventListener(
    "popstate",
    (e) => {
      // const previous = e.state?.previousPath || document.referrer;
      const current = window.location.pathname;
      console.log("popstate");

      // We don't reliably get "from", so we track it manually:
      const from = window.__lastPathname || current;
      const to = current;
      console.log(`from ${from} to ${to}`);

      if (isSameContentRoute(from, to)) {
        e.stopImmediatePropagation(); // 🔥 block Astro router
        e.preventDefault();
      }

      window.__lastPathname = current;
    },
    { capture: true },
  );

  // initialize tracker
  window.__lastPathname = window.location.pathname;

  document.addEventListener("astro:page-load", () => {
    console.log("page load");
  });
</script>
