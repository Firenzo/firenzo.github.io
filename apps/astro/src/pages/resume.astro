---
import BaseLayout from "../layouts/BaseLayout.astro";
import { resumePageSchema } from "../schemas/pageSchemas";
import { getTranslation } from "../helpers/translations";
import SkillList from "../components/SkillList.astro";
import Timeline from "../components/Timeline/Timeline.astro";

const { pageTitle, designSkills, frontEndSkills, experiences } =
  resumePageSchema.parse(Astro.locals.pageData);
---

<BaseLayout>
  <div class="breakout mb-3">
    <h1>{pageTitle}</h1>
    <h2 class="h2 block mb-1 lh-1">{getTranslation("skills.title")}</h2>
    <div class="skills-container-wrapper mt-2 mb-4">
      <SkillList
        skillList={designSkills}
        title={getTranslation("skills.design-software.title")}
      />
      <SkillList
        skillList={frontEndSkills}
        title={getTranslation("skills.front-end-development.title")}
      />
    </div>
    <div class="experience-container">
      <h2 class="mb-2">{getTranslation("experience.title")}</h2>
      <Timeline data={experiences} />
    </div>
  </div>
</BaseLayout>
