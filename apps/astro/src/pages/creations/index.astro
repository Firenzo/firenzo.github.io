---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { creationsPageSchema } from "../../schemas/pageSchemas";
import ProjectLinkCard from "../../components/ProjectLinkCard.astro";
import Pill from "../../components/Pill.astro";
const { pageTitle, creations } = creationsPageSchema.parse(
  Astro.locals.pageData,
);
---

<BaseLayout>
  <div class="breakout">
    <h1>{pageTitle}</h1>
    <ul class="project-list no-bullets">
      {
        creations.map((creation) => (
          <li class="project-item">
            <h2 class="project-item-title">{creation.name}</h2>
            <ProjectLinkCard creation={creation} />
            <ul class="tag-list">
              {creation.tags.map((tag) => (
                <li class="tag-item">
                  <Pill content={tag} />
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>

<style lang="scss">
  @use "../../styles/breakpoints.scss" as mq;

  .content-grid p {
    background: gold;
  }

  .project-item-title {
    display: flex;
    align-items: flex-end;
    line-height: 1.2;
    font-size: var(--font-size-large);
    text-wrap: pretty;

    @include mq.up("xl-tablet") {
      height: 2.4em;
    }
  }

  .project-list {
    @include mq.up("xl-tablet") {
      --columns: 2;
      display: grid;
      grid-template-columns: repeat(var(--columns), 1fr);
      column-gap: 2%;
    }

    @include mq.up("bigscreen") {
      --columns: 3;
    }
  }

  .project-item::before,
  .tag-item::before {
    display: none;
  }

  .project-item {
    min-width: 0;
    margin-bottom: 2rem;
  }

  .tag-item {
    margin-bottom: 0.25rem;

    @include mq.up("big-phone") {
      margin-bottom: 0.5rem;
    }
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    column-gap: 0.25rem;
    justify-content: flex-start;

    @include mq.up("big-phone") {
      column-gap: 0.5rem;
    }
  }
</style>
