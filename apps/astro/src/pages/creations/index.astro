---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getIcon } from "@repo/iconset";
import { Icon } from "@repo/iconset/components";

import { creationsPageSchema } from "../../schemas/pageSchemas";
import ProjectLinkCard from "../../components/ProjectLinkCard.astro";
import Pill from "../../components/Pill.astro";
const { pageTitle, creations } = creationsPageSchema.parse(
  Astro.locals.pageData,
);
---

<BaseLayout>
  <div class="breakout">
    <h1>{pageTitle}</h1>
    <ul class="project-list">
      {
        Array.from({ length: 12 }, () => ({ ...creations[0] })).map(
          (creation) => (
            <li class="project-item">
              <h2 class="project-item-title">{creation.name}</h2>
              <ProjectLinkCard creation={creation} />
              <ul class="tag-list">
                {creation.tags.map((tag) => (
                  <li class="tag-item">
                    <Pill content={tag} />
                  </li>
                ))}
              </ul>
            </li>
          ),
        )
      }
    </ul>
  </div>
</BaseLayout>

<style lang="scss">
  @use "../../styles/breakpoints.scss" as mq;

  .content-grid p {
    background: gold;
  }

  .project-item::before,
  .tag-item::before {
    display: none;
  }

  .project-item-title {
    font-size: var(--font-size-large);
  }

  .project-list {
    @include mq.up("xl-tablet") {
      --columns: 2;
      display: grid;
      grid-template-columns: repeat(var(--columns), 1fr);
      column-gap: 2%;
    }

    @include mq.up("bigscreen") {
      --columns: 3;
    }
  }

  .project-item {
    min-width: 0;
  }

  .tag-list {
    margin-top: 10px;
    display: flex;
    flex-wrap: wrap;
    column-gap: 0.25rem;
    row-garp: 1rem;
    justify-content: flex-start;
  }
</style>
