---
import BaseLayout from "../layouts/BaseLayout.astro";
import RichText from "../components/RichText.astro";
import { STRAPI_URL } from "../helpers/url";
import { aboutMePageSchema, type PageData } from "../schemas/pageSchemas";
import LazyImage from "../components/LazyImage.astro";
import { getPageData } from "../helpers/getPageData";

const requestUrl = new URL(Astro.request.url);
const pageData = await getPageData(requestUrl);
const { pageTitle, introText, name, role, picture } =
  aboutMePageSchema.parse(pageData);
---

<BaseLayout>
  <div class="breakout title mb-3">
    <h1>{pageTitle}</h1>
    <span class="h2 block mb-1 lh-1">{name}</span>
    <span class="large-text lh-1">{role}</span>
  </div>

  <article class="breakout two-column-layout">
    <div class="image-container">
      <LazyImage
        src={STRAPI_URL + picture.url}
        imageWidth={picture.width}
        imageHeight={picture.height}
        alt={picture.altText}
        withSkeleton={false}
        className="profile-pic"
      />
    </div>

    <div class="content">
      <RichText content={introText} />
    </div>
  </article>
</BaseLayout>

<style lang="scss">
  @use "../styles/breakpoints.scss" as mq;

  $column-max-width: 800px;

  .two-column-layout {
    display: flex;
    flex-direction: column;
  }

  @include mq.up("desktop") {
    .two-column-layout {
      flex-direction: row;
      gap: 3rem;

      & > .content {
        max-width: $column-max-width;
        flex-basis: 50%;
        margin-bottom: calc(100vh - 640px);
      }
    }
  }

  .image-container {
    display: flex;
    justify-content: center;
  }

  :global(.profile-pic) {
    border-radius: 2000px;
    max-width: 550px;
    overflow: visible !important;
    margin-bottom: 35px;
  }

  :global(.profile-pic img) {
    position: sticky;
    top: 1.25rem;
    width: 100%;
    border-radius: 2000px;
    border: 8px solid #fff;
    box-shadow:
      -3px -3px 6px hsla(0, 0%, 100%, 0.7),
      3px 3px 6px rgba(0, 0, 0, 0.86);
    display: block;
    margin: auto;

    @include mq.up("desktop") {
      max-width: $column-max-width;
    }
  }
</style>
