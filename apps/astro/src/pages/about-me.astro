---
import BaseLayout from "../layouts/BaseLayout.astro";
import RichText from "../components/RichText.astro";
import { STRAPI_URL } from "../helpers/url";
import { aboutMePageSchema } from "../schemas/pageSchemas";

const { pageTitle, introText, name, role, picture } = aboutMePageSchema.parse(
  Astro.locals.pageData,
);
---

<BaseLayout>
  <div class="breakout title mb-3">
    <h1>{pageTitle}</h1>
    <span class="h2 block mb-1 lh-1">{name}</span>
    <span class="large-text lh-1">{role}</span>
  </div>

  <article class="breakout two-column-layout">
    <div class="image-wrapper">
      <img
        class="profile-pic"
        src={STRAPI_URL + picture.url}
        loading="lazy"
        alt={picture.altText}
      />
    </div>

    <div class="content">
      <RichText content={introText} />
    </div>
  </article>
</BaseLayout>

<style lang="scss">
  @use "../styles/breakpoints.scss" as mq;

  $column-max-width: 800px;

  .two-column-layout {
    display: flex;
    flex-direction: column;
  }

  @include mq.up("desktop") {
    .two-column-layout {
      flex-direction: row;
      gap: 3rem;

      & > .content {
        max-width: $column-max-width;
        flex-basis: 50%;
        margin-bottom: calc(100vh - 640px);
      }
    }
  }

  .profile-pic {
    position: sticky;
    top: 1.25rem;
    width: 100%;
    border-radius: 2000px;
    border: 8px solid #fff;
    box-shadow:
      -3px -3px 6px hsla(0, 0%, 100%, 0.7),
      3px 3px 6px rgba(0, 0, 0, 0.86);
    display: block;
    margin: auto;
    margin-bottom: 35px;
    max-width: $column-max-width;
  }
</style>
