---
import { getAssetURL, getPageUrl } from "../helpers/url";
import type { ProjectPage } from "../schemas/pageSchemas";
import LazyImage from "./LazyImage.astro";

type ProjectLinkCardProps = {
  creation: ProjectPage["project"];
};

const { creation } = Astro.props as ProjectLinkCardProps;
---

<a
  class="project-link-card"
  href={getPageUrl(`/creations/${creation.nameInUrl}`)}
>
  <div class="image-container">
    <LazyImage
      src={getAssetURL(creation.image?.url)}
      alt={creation.image?.altText}
      imageWidth={creation.image?.width}
      imageHeight={creation.image?.height}
      className="project-image"
    />
  </div>
</a>

<style lang="scss">
  .project-link-card {
    position: relative;
    display: inline-block;
    border-radius: 10px;
    box-shadow:
      inset -2px -2px 3px rgba(0, 0, 0, 0.5),
      inset 4px 4px 3px hsla(0, 0%, 100%, 0.5);
    width: 100%;

    &::after {
      content: "";
      display: block;
      padding-top: 61.27451%;
      border-radius: 10px;
    }
  }

  .image-container {
    position: absolute;
    z-index: -1;
    width: 100%;
    height: 100%;
    border-radius: 10px;
  }

  :global(.project-image) {
    border-radius: 10px;
  }
</style>
