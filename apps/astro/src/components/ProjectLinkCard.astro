---
import { STRAPI_URL } from "../helpers/url";
import type { ProjectContent, ProjectPage } from "../schemas/pageSchemas";

type ProjectLinkCardProps = {
  creation: ProjectPage["project"];
};

const { creation } = Astro.props as ProjectLinkCardProps;
---

<a class="project-link-card" href={`/creations/${creation.nameInUrl}`}>
  <div class="image-container">
    <img src={STRAPI_URL + creation.image?.url} alt={creation.image?.altText} />
  </div>
</a>

<style lang="scss">
  .project-link-card {
    position: relative;
    display: inline-block;
    border-radius: 10px;
    box-shadow:
      inset -2px -2px 3px rgba(0, 0, 0, 0.5),
      inset 4px 4px 3px hsla(0, 0%, 100%, 0.5);
    width: 100%;

    &::after {
      content: "";
      display: block;
      padding-top: 61.27451%;
      border-radius: 10px;
    }
  }

  .image-container {
    position: absolute;
    z-index: -1;
    width: 100%;
    height: 100%;
    border-radius: 10px;

    > img {
      width: 100%;
      border-radius: 10px;
      vertical-align: top;
    }
  }
</style>
