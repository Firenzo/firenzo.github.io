---
import { Icon } from "@repo/iconset/components";

const slideOutIn = {
  old: {
    name: "slideOut",
    duration: "0.4s",
    easing: "ease-in",
    direction: "reverse",
  },
  new: {
    name: "slideIn",
    duration: "0.4s",
    delay: "0.4s",
    easing: "ease-in-out",
  },
};

const pageTransition = {
  forwards: slideOutIn,
  backwards: slideOutIn,
};

const requestUrl = new URL(Astro.request.url);
const isCreationsPage = requestUrl.pathname.match(/^\/creations(?:\/.*)?$/);
const isResumePage = ["/resume", "/resume/"].includes(requestUrl.pathname);
const isAboutMePage = ["/about-me", "/about-me/"].includes(requestUrl.pathname);
const isContactPage = ["/contact", "/contact/"].includes(requestUrl.pathname);
---

<div class="navigation-wrapper breakout">
  <svg style="display:none;" aria-hidden>
    <filter id="displacementFilter">
      <feImage
        href="data:image/png;base64,"
        preserveAspectRatio="none"></feImage>

      <!-- <feTurbulence
        type="turbulence"
        baseFrequency="0.01"
        numOctaves="2"
        result="turbulence"></feTurbulence> -->

      <feDisplacementMap
        in="SourceGraphic"
        in2="turbulence"
        scale="200"
        xChannelSelector="R"
        yChannelSelector="G"></feDisplacementMap>
    </filter>
  </svg>
  <nav class="navigation">
    {
      requestUrl.pathname.substring(0, 12).startsWith("/creations/") && (
        <a
          transition:animate={pageTransition}
          href="/creations"
          class="navigation-button back-button"
          aria-label="Go back to creations"
        >
          <Icon
            icon="ic-chevron-left"
            color="white"
            size={16}
            className="mr-0.5"
          />
          Back
        </a>
      )
    }

    <button
      class="navigation-button menu-button"
      popovertarget="mobile-nav-menu"
    >
      <Icon icon="ic-bars" color="white" />
    </button>

    <div id="mobile-nav-menu" role="menu" popover="auto" class="nav-menu">
      <ul>
        <li class:list={[{ active: isAboutMePage }]}>
          <a href="/about-me">
            <Icon icon="ic-user" color="white" className="mr-1" /> About me
          </a>
          <li class:list={[{ active: isResumePage }]}>
            <a href="/resume"
              ><Icon
                icon="ic-file-lines"
                color="white"
                className="mr-1"
              />Resume</a
            >
          </li>
          <li class:list={[{ active: isCreationsPage }]}>
            <a href="/creations"
              ><Icon
                icon="ic-pen-ruler"
                color="white"
                class="mr-1"
              />Creations</a
            >
          </li>
          <li class:list={[{ active: isContactPage }]}>
            <a href="/contact"
              ><Icon icon="ic-envelope" color="white" class="mr-1" />Contact</a
            >
          </li>
        </li>
      </ul>
    </div>

    <ul class="link-list">
      <li class:list={[{ active: isAboutMePage }]}>
        <a href="/about-me"
          ><Icon icon="ic-user" color="white" className="mr-1" />About me</a
        >
      </li>
      <li class:list={[{ active: isResumePage }]}>
        <a href="/resume"
          ><Icon icon="ic-file-lines" color="white" className="mr-1" />Resume</a
        >
      </li>
      <li class:list={[{ active: isCreationsPage }]}>
        <a href="/creations"
          ><Icon
            icon="ic-pen-ruler"
            color="white"
            className="mr-1"
          />Creations</a
        >
      </li>
      <li class:list={[{ active: isContactPage }]}>
        <a href="/contact"
          ><Icon icon="ic-envelope" color="white" className="mr-1" />Contact</a
        >
      </li>
    </ul>
  </nav>

  <style lang="scss">
    @use "../styles/breakpoints.scss" as mq;

    .navigation-wrapper {
      --nav-height: 55px;
      position: relative;
      container-type: inline-size;
    }

    .navigation {
      display: flex;
      align-items: center;
      position: fixed;
      top: 1.25rem;
      width: 100cqw;
      height: var(--nav-height);
      z-index: 100;
    }

    .navigation-button {
      height: var(--nav-height);
      color: #fff;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--font-inter);
      pointer-events: auto;
      text-decoration: none;
      border-radius: 8px;
      outline: none;
      border: none;
    }

    .back-button {
      background: linear-gradient(90deg, #393939, #000);
      box-shadow:
        -3px -3px 4px #fff,
        3px 3px 5px #000;
      padding: 0 1rem;
      justify-self: flex-start;
    }

    .menu-button {
      anchor-name: --navigation-menu-button;
      width: var(--nav-height);
      background: linear-gradient(90deg, #9500f0, #a74fdd);
      box-shadow:
        -3px -3px 4px #d6b5ea,
        3px 3px 5px #6f249d;
      margin-left: auto;
      opacity: 1;
      transition-behavior: allow-discrete;
      transition-property: opacity, display;
      transition-duration: 0.4s;
      display: block;

      @starting-style {
        opacity: 0;
      }

      &.hide {
        opacity: 0;
        display: none;
      }

      &:hover {
        cursor: pointer;
      }

      @include mq.upSpecific(833px) {
        display: none;
      }
    }

    .nav-menu {
      position-anchor: --navigation-menu-button;
      background: linear-gradient(
        90deg,
        rgba(148, 0, 240, 0.9),
        rgba(167, 79, 221, 0.9)
      );
      box-shadow:
        -3px -3px 4px #d6b5ea,
        3px 3px 5px #6f249d;
      filter: drop-shadow(-8px -10px 46px #0000005f);
      // backdrop-filter: brightness(1.1) blur(2px) url(#displacementFilter);
      backdrop-filter: brightness(1.1) blur(2px);
      border: none;
      border-radius: 16px;
      inset: auto;
      top: anchor(bottom);
      right: anchor(right);
      margin-block-start: 0.5rem;
      max-width: 265px;

      ul {
        li {
          margin-bottom: 0;

          &:before {
            display: none;
          }

          &.active {
            background: rgba(255, 255, 255, 0.3);
          }

          &:hover {
            background: rgba(255, 255, 255, 0.2);
          }

          a {
            color: var(--color-white);
            display: flex;
            align-items: center;
            width: 80vw;
            height: 90px;
            padding-inline-start: 1.5rem;
            font-size: var(--font-size-medium);

            &:hover {
              text-decoration: none;
            }
          }
        }
      }
    }

    .link-list {
      display: none;
      margin-left: auto;

      gap: 0.25rem;
      justify-content: flex-end;
      height: 100%;
      align-items: center;
      border-radius: 10px;
      background: rgba(150, 150, 150, 0.5);
      filter: drop-shadow(-8px -10px 46px #0000005f);
      // backdrop-filter: brightness(1.1) blur(2px) url(#displacementFilter);
      backdrop-filter: brightness(1.1) blur(2px);
      box-shadow: 0px -2px 3px #FFF,1px 1px 4px #000;

      @include mq.upSpecific(833px) {
        display: flex;
      }

      li {
        margin-bottom: 0;
        height: 100%;
        display: flex;
        align-items: center;
        padding-inline: 0.125rem;
        border-radius: inherit;

        &.active {
          background: linear-gradient(
            90deg,
            rgba(148, 0, 240, 0.8),
            rgba(167, 79, 221, 0.8)
          );
          filter: drop-shadow(-8px -10px 46px #0000005f);
          // backdrop-filter: brightness(1.1) blur(2px) url(#displacementFilter);
        }

        &:before {
          display: none;
        }

        a {
          color: var(--color-white);
          font-family: var(--font-inter);
          font-size: var(--font-size-small);
          width: 100%;
          height: 100%;
          display: flex;
          align-items: center;
          padding-inline: 1rem;

          &:hover {
            text-decoration: none;
          }
        }
      }
    }
  </style>
</div>
