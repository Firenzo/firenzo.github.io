---
import { getAssetURL } from "../helpers/url";
import type { ResumePage } from "../schemas/pageSchemas";
import LazyImage from "./LazyImage.astro";

type SkillListProps = {
  skillList: ResumePage["designSkills"] | ResumePage["frontEndSkills"];
  title: string;
};

const { skillList, title } = Astro.props as SkillListProps;
---

<div class="skill-container">
  <h3 class="large-text">
    {title}
  </h3>
  <ul class="skill-list no-bullets mt-4">
    {
      skillList.map((skill) => (
        <li class="skill-item">
          <LazyImage
            src={getAssetURL(skill.logo.url)}
            alt={skill.logo.altText}
            imageWidth={95}
            imageHeight={95}
            renderHeight={95}
            renderHeight={95}
          />
          <span class="mt-1 lh-1">{skill.name}</span>
        </li>
      ))
    }
  </ul>
</div>

<style lang="scss">
  @use "../styles/breakpoints.scss" as mq;

  .skill-list {
    --column-gap: 1rem;
    --max-items-in-row: 7;
    --item-max-width: 120px;

    display: flex;
    flex-wrap: wrap;
    gap: var(--column-gap);

    max-width: calc(
      var(--item-max-width) * var(--max-items-in-row) + var(--column-gap) *
        (var(--max-items-in-row) - 1)
    );

    .skill-item {
      display: flex;
      flex-direction: column;
      align-items: center;
      flex-basis: calc(50% - var(--column-gap));

      @include mq.up("phone") {
        flex-basis: auto;
        width: var(--item-max-width);
      }

      span {
        text-align: center;
        text-wrap: balance;
        font-size: var(--font-size-small);
        font-weight: 900;
      }

      &::before {
        display: none;
      }
    }
  }
</style>
