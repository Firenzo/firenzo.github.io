---
import type { IconClassName } from "@repo/iconset";
import { Icon } from "@repo/iconset/components";
import Button from "./ContentBlocks/Button.astro";

type GoToProjectButtonProps = {
  text: string;
  url: string;
  color: "primary" | "black";
};

const { text, url, color = "black" } = Astro.props as GoToProjectButtonProps;
---

<Button
  displayText={text}
  url={url}
  backgroundColor={color}
  icon={{ name: "ic-chevron-right", color: "white" }}
/>
