---
import { getIcon } from "@repo/iconset";
import { Icon } from "@repo/iconset/components";
import type { TimelineProps } from "./Timeline.astro";
import RichText from "../RichText.astro";

export type TimelineItemEntry = TimelineProps["data"][number];

const {
  role,
  company,
  description,
  country,
  city,
  startDate,
  endDate,
  additionalText,
} = Astro.props as TimelineItemEntry;
---

<li class="timeline-item-wrapper">
  <div class="timeline-marker">
    <Icon icon={getIcon("location-dot")} color="white" />
  </div>
  <div class="timeline-item">
    {role && <h3 class="role">{role}</h3>}
    {company && <p class="organization">{company}</p>}

    {
      country && city && (
        <p class="location">
          {city}, {country}
        </p>
      )
    }

    {
      startDate && endDate && (
        <p class="duration">
          <time class="duration__start">{startDate}</time> —{" "}
          <time class="duration__end">{endDate}</time>
        </p>
      )
    }

    {additionalText && <p class="additional-text">{additionalText}</p>}

    {description && <RichText content={description} />}
  </div>

  <style lang="scss">
    @use "../../styles/breakpoints.scss" as mq;

    .timeline-item-wrapper {
      --marker-size: 40px;

      @include mq.up("phone") {
        --marker-size: 60px;
      }

      position: relative;
      color: #fff;
      padding-inline-start: 0;
      margin-block-end: 0;
      margin-bottom: 1rem;

      &::before {
        content: "";
        position: absolute;
      }

      .timeline-item {
        padding: 1rem 1.5rem;
        min-height: 100px;
        margin-block-end: 0;
        background: linear-gradient(90deg, #9500f0, #a74fdd);
        box-shadow:
          -5px -5px 8px rgba(214, 181, 234, 0.25),
          5px 5px 8px rgba(111, 36, 157, 0.41),
          inset 3px 3px 3px hsla(0, 0%, 100%, 0.25),
          inset 0 0 3px rgba(0, 0, 0, 0.5);
        border-radius: 17px;

        @include mq.up("desktop") {
          width: calc(100% / 2 - var(--marker-size));
        }
      }

      @include mq.up("desktop") {
        &:nth-child(2n) .timeline-item {
          float: right;
        }
      }

      .timeline-marker {
        display: flex;
        justify-content: center;
        align-items: center;
        height: var(--marker-size);
        width: var(--marker-size);
        border-radius: 100px;
        position: absolute;
        top: 2rem;
        left: calc(
          -1 * var(--line-content-gap) -
            (var(--marker-size) / 2 + var(--line-width) / 2)
        );
        background: linear-gradient(90deg, #9500f0, #a74fdd);
        box-shadow:
          -3px -3px 5px hsla(0, 0%, 100%, 0.4),
          3px 3px 5px rgba(76, 36, 102, 0.38),
          inset 3px 3px 6px hsla(0, 0%, 100%, 0.5),
          inset -1px -1px 3px rgba(0, 0, 0, 0.5);

        @include mq.up("big-phone") {
          top: calc(100% / 2 - var(--marker-size) / 2);
        }

        @include mq.up("desktop") {
          left: calc(100% / 2 - var(--marker-size) / 2);
        }

        [class^="ic-"],
        [class*=" ic-"] {
          width: 16px;
          height: 16px;
        }
      }

      .role {
        font-size: var(--font-size-base);
        margin-bottom: 0.5rem;
      }

      .organization {
        font-size: var(--font-size-normal);
        font-weight: 600;
        margin-bottom: 0;
      }

      .location {
        font-size: var(--font-size-xs);
        margin-bottom: 1rem;
      }

      .duration {
        font-size: var(--font-size-xs);
      }

      .additional-text {
        font-size: var(--font-size-xs);
      }
    }
  </style>

  <style is:global lang="scss">
    @use "../../styles/breakpoints.scss" as mq;

    @include mq.down("phone") {
      .timeline-marker [class^="ic-"],
      .timeline-marker [class*=" ic-"] {
        width: 16px;
        height: 16px;
      }
    }
  </style>
</li>
