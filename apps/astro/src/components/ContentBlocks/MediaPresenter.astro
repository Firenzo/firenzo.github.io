---
import { STRAPI_URL } from "../../helpers/url";
import type { MediaPresenterComponent } from "../../schemas/contentblockSchema";
import FullWidthBox from "../FullWidthBox.astro";
import LazyImage from "../LazyImage.astro";

const { title, description, image, scrollable, headingLevel } =
  Astro.props as MediaPresenterComponent;

const scaleFactor = 0.8;
const imageWidth = image.width! * scaleFactor;
const imageHeight = image.height! * scaleFactor;
const HeadingElement = headingLevel;
---

<FullWidthBox>
  <slot>
    <div class="media-presenter-block-header text-on-primary">
      <HeadingElement class="media-title">{title}</HeadingElement>
      <p class="media-description">{description}</p>
    </div>
    {
      scrollable ? (
        <div class="scrollable-image full-width">
          <div
            class="image-container"
            style={{ width: `${imageWidth}px`, height: `${imageHeight}px` }}
          >
            <LazyImage
              src={STRAPI_URL + image.url}
              alt={image.altText}
              imageWidth={image.width}
              imageHeight={image.height}
              withSkeleton={true}
            />
          </div>
        </div>
      ) : (
        <div class="image-container">
          <img src={STRAPI_URL + image.url} alt={image.altText} />
        </div>
      )
    }
  </slot>
</FullWidthBox>

<style lang="scss">
  .image-container {
    > img {
      width: 100%;
      border-radius: 10px;
      box-shadow: 0 2px 7px rgba(0, 0, 0, 0.5);
    }
  }

  .scrollable-image {
    width: 100%;
    overflow-y: hidden;
    overflow-x: scroll;
    -webkit-overflow-scrolling: touch;
    padding-bottom: 20px;

    // scrollbar styling hack
    background-color: rgba(136, 136, 136, 0);
    -webkit-background-clip: text;
    background-clip: text;
    transition: background-color 0.4s ease;

    &::-webkit-scrollbar-track {
      border-radius: 10px;
      background-color: transparent;
      margin-left: 5vw;
      margin-right: 5vw;
    }

    &::-webkit-scrollbar {
      height: 15px;
      background-color: transparent;
    }

    &::-webkit-scrollbar-thumb {
      border-radius: 10px;
      background-color: inherit;
    }

    &:hover {
      background-color: rgba(0, 0, 0, 0.4);
    }

    .image-container > img {
      //TODO simplify grid so this can be calculated

      margin-right: calc(50vw - (min(100%, var(--content-max-width)) / 2));

      // margin-right: min(
      //   max(0px, calc(var(--breakout-size) + var(--padding-inline))),
      //   max(0px, calc(50vw - (min(100%, var(--content-max-width)) / 2)))
      // );
      // margin-right: calc(
      //   (
      //       100vw - min(
      //           100% - (var(--padding-inline) * 2),
      //           var(--content-max-width)
      //         )
      //     ) /
      //     2
      // );
    }
  }
</style>
