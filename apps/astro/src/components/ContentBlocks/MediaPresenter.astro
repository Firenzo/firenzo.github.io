---
import { getAssetURL } from "../../helpers/url";
import type { MediaPresenterComponent } from "../../schemas/contentblockSchema";
import FullWidthBox from "../FullWidthBox.astro";
import LazyImage from "../LazyImage.astro";

const { title, description, image, scrollable, headingLevel } =
  Astro.props as MediaPresenterComponent;

const scaleFactor = 0.8;
const imageWidth = image.width! * scaleFactor;
const imageHeight = image.height! * scaleFactor;
const HeadingElement = headingLevel;
---

<FullWidthBox>
  <slot>
    <div class="media-presenter-block-header text-on-primary">
      <HeadingElement class="media-title">{title}</HeadingElement>
      <p class="media-description">{description}</p>
    </div>
    {
      scrollable ? (
        <div class="scrollable-image full-width">
          <div
            class="image-container"
            style={{ width: `${imageWidth}px`, height: `${imageHeight}px` }}
          >
            <LazyImage
              src={getAssetURL(image.url)}
              alt={image.altText}
              imageWidth={image.width}
              imageHeight={image.height}
              withSkeleton={true}
              className="shadow"
            />
          </div>
        </div>
      ) : (
        <div class="image-container">
          <img src={getAssetURL(image.url)} alt={image.altText} />
        </div>
      )
    }
  </slot>
</FullWidthBox>

<style lang="scss">
  .scrollable-image {
    width: 100%;
    overflow-y: hidden;
    overflow-x: scroll;
    -webkit-overflow-scrolling: touch;
    padding-bottom: 20px;

    // scrollbar styling hack
    background-color: rgba(136, 136, 136, 0);
    -webkit-background-clip: text;
    background-clip: text;
    transition: background-color 0.4s ease;

    &::-webkit-scrollbar-track {
      border-radius: 10px;
      background-color: transparent;
      margin-left: 5vw;
      margin-right: 5vw;
    }

    &::-webkit-scrollbar {
      height: 15px;
      background-color: transparent;
    }

    &::-webkit-scrollbar-thumb {
      border-radius: 10px;
      background-color: inherit;
    }

    &:hover {
      background-color: rgba(0, 0, 0, 0.4);
    }
  }
</style>
