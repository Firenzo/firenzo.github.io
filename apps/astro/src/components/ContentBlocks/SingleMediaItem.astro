---
import { applyShadow } from "../../helpers/applyShadow";
import { STRAPI_URL } from "../../helpers/url";
import type { SingleMediaItemComponent } from "../../schemas/contentblockSchema";

type SingleMediaItemProps = SingleMediaItemComponent & {
  captionAlign?: "center" | "left" | "right";
  marginBottom?: boolean;
  bigCaption?: boolean;
};

const {
  media,
  showCaption,
  reduceMarginBottom,
  reduceMaxWidth,
  videoUrl,
  videoStill,
  identifier,
  captionAlign = "left",
  marginBottom = true,
  bigCaption = false,
} = Astro.props as SingleMediaItemProps;

const isVideo = media.mime === "video/mp4";
const isImage = !isVideo;

const videoUrlPlatform = videoUrl?.includes("www.youtube.com")
  ? "Youtube"
  : "this page";
---

<div
  class:list={[
    "single-media-item",
    { "reduce-margin-bottom": reduceMarginBottom },
    { "reduce-max-width": reduceMaxWidth },
    { "margin-bottom": marginBottom },
  ]}
>
  <div id={identifier} class="media">
    {
      isVideo && (
        <>
          <video
            controls="controls"
            poster={videoStill?.url ? STRAPI_URL + videoStill.url : undefined}
            class="shadow"
          >
            <source src={STRAPI_URL + media.url} type={media.mime} /> Your
            browser does not support the video tag
          </video>
          {videoUrl && (
            <p class="caption">
              This video is also available on{" "}
              <a href={videoUrl} target="_blank">
                {videoUrlPlatform}
              </a>
            </p>
          )}
        </>
      )
    }

    {
      isImage && (
        <img
          src={STRAPI_URL + media.url}
          alt={media.altText}
          class:list={[{ shadow: applyShadow(media) }]}
        />
      )
    }
  </div>
  {
    showCaption && media.caption && (
      <p class:list={[bigCaption ? "big-caption" : "caption", captionAlign]}>
        {media.caption}
      </p>
    )
  }
</div>

<style lang="scss">
  .media {
    margin-inline: auto;
  }

  .single-media-item {
    width: 100%;
    margin-inline: auto;

    &.margin-bottom {
      margin-bottom: 3.125rem;
    }

    &.reduce-max-width {
      max-width: 600px;
    }

    &.reduce-margin-bottom {
      margin-bottom: 2rem;
    }

    .media {
      width: 100%;

      > img,
      video {
        width: 100%;
        display: block;
        border-radius: 10px;
      }
    }
  }

  .caption,
  .big-caption {
    &.left {
      text-align: left;
    }

    &.center {
      text-align: center;
    }

    &.right {
      text-align: right;
    }
  }
</style>
