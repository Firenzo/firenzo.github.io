---
import { STRAPI_URL } from "../../helpers/url";
import type { SingleMediaItemComponent } from "../../schemas/contentblockSchema";

type SingleMediaItemProps = SingleMediaItemComponent & {
  captionAlign?: "center" | "left" | "right";
  marginBottom?: boolean;
  bigCaption?: boolean;
};

const {
  image,
  showCaption,
  reduceMarginBottom,
  reduceMaxWidth,
  captionAlign = "left",
  marginBottom = true,
  bigCaption = false,
} = Astro.props as SingleMediaItemProps;

const applyShadow = !(image.url.endsWith("svg") || image.url.endsWith("png"));
---

<div
  class:list={[
    "single-media-item",
    { "reduce-margin-bottom": reduceMarginBottom },
    { "reduce-max-width": reduceMaxWidth },
    { "margin-bottom": marginBottom },
  ]}
>
  <div class="image">
    <img
      src={STRAPI_URL + image.url}
      alt={image.altText}
      class:list={[{ shadow: applyShadow }]}
    />
  </div>
  {
    showCaption && image.caption && (
      <p class:list={[bigCaption ? "big-caption" : "caption", captionAlign]}>
        {image.caption}
      </p>
    )
  }
</div>

<style lang="scss">
  .single-media-item {
    width: 100%;
    margin-inline: auto;

    &.margin-bottom {
      margin-bottom: 3.125rem;
    }

    &.reduce-max-width {
      max-width: 600px;
    }

    &.reduce-margin-bottom {
      margin-bottom: 2rem;
    }

    .image {
      width: 100%;

      > img {
        width: 100%;
        display: block;
        border-radius: 10px;

        &.shadow {
          box-shadow: 0 0 8px rgba(0, 0, 0, 0.3);
        }
      }
    }
  }

  .caption,
  .big-caption {
    &.left {
      text-align: left;
    }

    &.center {
      text-align: center;
    }

    &.right {
      text-align: right;
    }
  }
</style>
