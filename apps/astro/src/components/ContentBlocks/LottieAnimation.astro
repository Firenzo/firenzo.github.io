---
import type { LottieAnimationComponent } from "../../schemas/contentblockSchema";

const {
  caption,
  background = "Dark",
  lottieJSON,
} = Astro.props as LottieAnimationComponent;

const lottieAnimation = JSON.stringify(lottieJSON);
---

<div
  class:list={[
    "lottie-animation-block",
    { dark: background === "Dark" },
    { light: background === "Light" },
  ]}
>
  <div class="lottie-animation"></div>
</div>
<p class="caption">{caption}</p>

<style lang="scss">
  .lottie-animation-block {
    width: 100%;
    padding: 20px 0;
    border-radius: 15px;

    &.dark {
      background: linear-gradient(177deg, #2b2b2b, #000);
    }

    // TODO: add light background, now it's the same color as dark
    &.light {
      background: linear-gradient(177deg, #2b2b2b, #000);
    }
  }
</style>

<script define:vars={{ lottieAnimation }}>
  window.lottieAnimation = lottieAnimation;
</script>

<script type="module">
  import lottie from "lottie-web";

  function initLottie() {
    const container = document.querySelector(".lottie-animation");

    if (!container) return;

    const lottieAnimation = lottie.loadAnimation({
      container,
      animationData: JSON.parse(window.lottieAnimation),
      autoplay: true,
      renderer: "svg",
      loop: false,
    });

    lottieAnimation.setSpeed(1.2);
    lottieAnimation.onComplete = function () {
      setTimeout(() => {
        this.goToAndPlay(1, true);
      }, 1000);
    };
  }

  document.addEventListener("astro:page-load", initLottie);
</script>
