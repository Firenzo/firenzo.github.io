---
import { getAssetURL } from "../../helpers/url";
import type { ImageSliderComponent } from "../../schemas/contentblockSchema";
import FullWidthBox from "../FullWidthBox.astro";
import RichText from "../RichText.astro";
import { applyShadow } from "../../helpers/applyShadow";
import LazyImage from "../LazyImage.astro";

const { imageSliderItems, headingLevel, identifier } =
  Astro.props as ImageSliderComponent;
const HeadingElement = headingLevel;
const randomId = "id-" + Math.random().toString(36).slice(2, 11);
---

<FullWidthBox>
  <image-slider
    id={`${identifier}-slider`}
    class="image-slider-wrapper full-width text-on-primary"
  >
    <div class="splide splide-container" id={randomId}>
      <div class="splide__track">
        <ul class="splide__list">
          {
            imageSliderItems.map((imageSlide) => {
              const hasAtLeastOneDescription = imageSliderItems.some(
                (item) => item.description,
              );
              return (
                <li class:list={["splide__slide", imageSlide.className]}>
                  <div
                    class:list={[
                      "slide-header",
                      "text-on-primary",
                      "selectable",
                    ]}
                  >
                    <HeadingElement
                      class:list={[
                        "media-title",
                        { "extra-margin": !hasAtLeastOneDescription },
                      ]}
                    >
                      {imageSlide.title}
                    </HeadingElement>
                    {imageSlide.description && (
                      <p class="media-description">{imageSlide.description}</p>
                    )}
                  </div>

                  <LazyImage
                    src={getAssetURL(imageSlide.image.url)}
                    alt={imageSlide.image.altText}
                    imageWidth={imageSlide.image.width}
                    imageHeight={imageSlide.image.height}
                    renderWidth={`calc(min(var(--content-width), var(--content-max-width)) * var(--image-scale-factor ))`}
                    className={
                      (applyShadow(imageSlide.image) ? "shadow" : "") +
                      " " +
                      "slide-image"
                    }
                    withSkeleton={true}
                    skeletonStyle={"onPrimary"}
                  />
                  <div class="slide-footer text-on-primary selectable">
                    <RichText content={imageSlide.additionalInfo} />
                  </div>
                </li>
              );
            })
          }
        </ul>
      </div>
    </div>
  </image-slider>
</FullWidthBox>

<style lang="scss">
  @use "../../styles/breakpoints.scss" as mq;

  .image-slider-wrapper {
    // These variable needs to be at the top level of this component for easier overriding
    // or using the variable in splide options.
    --image-width: calc(100% * var(--image-scale-factor, 1));
    --slide-header-min-height: none;
    --splide-arrow-height: 2em; /* setting splide's default value in variable so we can do math with it */

    > * {
      grid-column: full-width;
    }
  }

  .splide-container {
    visibility: visible !important;

    &:not(.is-initialized) {
      .splide__slide {
        opacity: 1;
      }

      .slide-footer,
      .slide-header {
        opacity: 1;
      }
    }

    &.is-initialized {
      .splide__slide:not(.is-active) {
        opacity: 0.6;

        &:hover {
          opacity: 0.85;
        }
      }

      .splide__slide:not(.is-active) .slide-header,
      .splide__slide:not(.is-active) .slide-footer {
        opacity: 0;
      }
    }
  }

  .splide__slide {
    display: flex;
    flex-direction: column;
    line-height: normal;
    width: calc(100%);
    margin-right: calc(var(--image-width) / 2);
    transition: opacity 0.4s ease;

    &:before {
      display: none;
    }
  }

  /* when using splides paddding option. The padding is only active when splide is done loading, causing CLS.
     When Splide's padding option is unset, it will give the splide__track a padding-left and padding-right of 0px.
     Therefore override the padding in CSS */

  .splide__track {
    padding-left: 5% !important;
    padding-right: 5% !important;

    @include mq.upSpecific(833px) {
      padding-left: calc((100% - var(--content-max-width)) / 2) !important;
      padding-right: calc((100% - var(--content-max-width)) / 2) !important;
    }
  }

  .slide-header {
    transition: opacity 0.4s ease;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: var(--slide-header-min-height);

    .media-title {
      margin-bottom: 1rem;

      &.extra-margin {
        margin-bottom: 2rem;
      }
    }

    .media-description {
      line-height: 1.2;
    }
  }

  .slide-footer {
    transition: opacity 0.4s ease;
  }

  :global(.slide-image) {
    align-self: center;
    overflow: visible !important;
    margin-bottom: 1rem;
  }

  :global(.slide-image img) {
    border-radius: 10px;
  }

  .selectable,
  .selectable * {
    user-select: text;
    -webkit-user-select: text;
  }
</style>

<style lang="scss" is:global>
  .splide__arrow.splide__arrow--prev,
  .splide__arrow.splide__arrow--next {
    height: var(--splide-arrow-height);

    // check if --image-height is set and apply styles if true
    // "initial" is the value if the variable is not set
    @container style(not (--image-height: initial)) {
      & {
        transform: none;
        top: calc(
          var(--slide-header-min-height) - (var(--splide-arrow-height) / 2) +
            (var(--image-height) / 2)
        );
      }
    }
  }

  .slide-footer {
    h1:first-child,
    h2:first-child,
    h3:first-child,
    h4:first-child,
    h5:first-child,
    h6:first-child {
      margin-bottom: 1.5rem;
      margin-top: 1rem;
      font-size: var(--font-normal);
    }

    ul {
      li:before {
        color: var(--colors-white);
      }
    }
  }
</style>

<script type="module">
  import Splide from "@splidejs/splide";

  const splideOptions = {
    focus: "center",
    perPage: 1,
    trimSpace: false,
    arrows: true,
    autoWidth: true,
    pagination: false,
    noDrag: ".selectable *",
  };

  class ImageSlider extends HTMLElement {
    splideInstance = null;
    resizeFrame = null;

    connectedCallback() {
      const sliderElement = this.querySelector(".splide");

      if (sliderElement instanceof HTMLElement) {
        this.splideInstance = new Splide(sliderElement, splideOptions);
        this.splideInstance.mount();

        this.resizeObserver = new ResizeObserver(() => {
          if (this.resizeFrame) {
            return;
          }

          this.resizeFrame = requestAnimationFrame(() => {
            this.resizeFrame = undefined;
            this.setImageHeight();
            this.normalizeHeaderHeight();
          });
        });

        this.resizeObserver.observe(this);
      }
    }

    normalizeHeaderHeight() {
      this.style.setProperty("--slide-header-min-height", "none");
      const allHeaders = this.querySelectorAll(".slide-header") ?? [];

      if (allHeaders.length) {
        const largestHeaderHeight = Math.max(
          ...[...allHeaders].map((header) => header.offsetHeight),
        );

        this.style.setProperty(
          "--slide-header-min-height",
          `${largestHeaderHeight}px`,
        );
      }
    }

    // Assuming the images in the slider will all have the same height,
    // get the height of the first image and set the css variable.
    setImageHeight() {
      const image = this.querySelector(".slide-image img");
      if (image) {
        this.style.setProperty("--image-height", `${image.offsetHeight}px`);
      }
    }

    disconnectedCallback() {
      if (this.splide) {
        this.splideInstance.destroy();
      }
      this.resizeObserver?.disconnect();
    }
  }

  customElements.define("image-slider", ImageSlider);
</script>
