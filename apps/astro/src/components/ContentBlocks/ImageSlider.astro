---
import { STRAPI_URL } from "../../helpers/url";
import type { ImageSliderComponent } from "../../schemas/contentblockSchema";
import FullWidthBox from "../FullWidthBox.astro";
import RichText from "../RichText.astro";
import { applyShadow } from "../../helpers/applyShadow";

const { imageSliderItems, headingLevel, identifier } =
  Astro.props as ImageSliderComponent;
const HeadingElement = headingLevel;
const randomId = "id-" + Math.random().toString(36).slice(2, 11);
---

<FullWidthBox>
  <image-slider
    id={`${identifier}-slider`}
    class="image-slider-wrapper full-width text-on-primary"
  >
    <div class="splide splide-container" id={randomId}>
      <div class="splide__track">
        <ul class="splide__list">
          {
            imageSliderItems.map((imageSlide) => {
              const hasAtLeastOneDescription = imageSliderItems.some(
                (item) => item.description,
              );
              return (
                <li class:list={["splide__slide", imageSlide.className]}>
                  <div
                    class:list={[
                      "slide-header",
                      "text-on-primary",
                      "selectable",
                      { "fixed-height": hasAtLeastOneDescription },
                    ]}
                  >
                    <HeadingElement
                      class:list={[
                        "media-title",
                        { "extra-margin": !hasAtLeastOneDescription },
                      ]}
                    >
                      {imageSlide.title}
                    </HeadingElement>
                    {imageSlide.description && (
                      <p class="media-description">{imageSlide.description}</p>
                    )}
                  </div>

                  <div class="image-container mb-1">
                    <img
                      class:list={[{ shadow: applyShadow(imageSlide.image) }]}
                      src={STRAPI_URL + imageSlide.image.url}
                      alt={imageSlide.image.altText}
                    />
                  </div>
                  <div class="slide-footer text-on-primary selectable">
                    <RichText content={imageSlide.additionalInfo} />
                  </div>
                </li>
              );
            })
          }
        </ul>
      </div>
    </div>
  </image-slider>
</FullWidthBox>

<style lang="scss">
  @use "../../styles/breakpoints.scss" as mq;

  .image-slider-wrapper {
    // This variable needs to be at the top level of this component, because it's
    // also used to set the gap in splide options
    --image-width: calc(100% * var(--image-scale-factor, 1));

    > * {
      grid-column: full-width;
    }
  }

  .splide__slide {
    display: flex;
    flex-direction: column;
    line-height: normal;
    width: calc(100%);
    opacity: 0.6;

    transition: opacity 0.4s ease;

    &:hover {
      opacity: 0.85;
    }

    &.is-active.is-visible {
      opacity: 1;
    }

    &:before {
      display: none;
    }

    &:not(.is-active) .slide-header,
    &:not(.is-active) .slide-footer {
      opacity: 0;
    }
  }

  .slide-header {
    transition: opacity 0.4s ease;
    display: flex;
    flex-direction: column;
    justify-content: center;

    &.fixed-height {
      height: 7em;
    }

    .media-title {
      margin-bottom: 1rem;

      &.extra-margin {
        margin-bottom: 2rem;
      }
    }

    .media-description {
      line-height: 1.2;
    }
  }

  .slide-footer {
    transition: opacity 0.4s ease;
  }

  .image-container {
    width: var(--image-width);
    align-self: center;

    > img {
      display: block;
      width: 100%;
      border-radius: 10px;
    }
  }

  .selectable,
  .selectable * {
    user-select: text;
    -webkit-user-select: text;
  }
</style>

<style lang="scss" is:global>
  .slide-footer {
    h1:first-child,
    h2:first-child,
    h3:first-child,
    h4:first-child,
    h5:first-child,
    h6:first-child {
      margin-bottom: 1.5rem;
      margin-top: 1rem;
      font-size: var(--font-normal);
    }

    ul {
      li:before {
        color: var(--colors-white);
      }
    }
  }
</style>

<script type="module">
  import Splide from "@splidejs/splide";

  const splideOptions = {
    focus: "center",
    perPage: 1,
    trimSpace: false,
    gap: "calc(var(--image-width) / 2)",
    padding: "calc( (100% - var(--content-max-width)) / 2)",
    arrows: true,
    autoWidth: true,
    pagination: false,
    noDrag: ".selectable *",

    breakpoints: {
      1899: {
        gap: "calc(var(--image-width) / 2)",
        padding: "calc( (100% - var(--content-max-width)) / 2)",
      },
      1499: {
        gap: "calc(var(--image-width) / 2)",
        padding: "calc( (100% - var(--content-max-width)) / 2)",
      },
      1299: {
        gap: "calc(var(--image-width) / 2)",
        padding: "calc( (100% - var(--content-max-width)) / 2)",
      },

      1023: {
        gap: "calc(var(--image-width) / 2)",
        padding: "calc( (100% - var(--content-max-width)) / 2)",
      },

      833: {
        gap: "20px",
        padding: "5%",
      },
    },
  };

  class ImageSlider extends HTMLElement {
    splideInstance = null;

    connectedCallback() {
      const sliderElement = this.querySelector(".splide");

      if (sliderElement instanceof HTMLElement) {
        this.splideInstance = new Splide(sliderElement, splideOptions);
        this.splideInstance.mount();
      }
    }

    disconnectedCallback() {
      if (this.splide) {
        this.splideInstance.destroy();
      }
    }
  }

  customElements.define("image-slider", ImageSlider);
</script>
