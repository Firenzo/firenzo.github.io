{
  "kind": "collectionType",
  "collectionName": "pages",
  "info": {
    "singularName": "page",
    "pluralName": "pages",
    "displayName": "Page"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "pageTitle": {
      "type": "string"
    },
    "url": {
      "type": "string",
      "unique": true
    },
    "translations": {
      "type": "json"
    },
    "icon": {
      "type": "customField",
      "customField": "plugin::icon-field.icon",
      "options": {
        "addColorSelector": false,
        "addSizeSelector": false
      }
    }
  }
}
