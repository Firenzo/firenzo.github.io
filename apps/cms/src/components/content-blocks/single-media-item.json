{
  "collectionName": "components_content_blocks_single_media_items",
  "info": {
    "displayName": "Single media item",
    "icon": "television"
  },
  "options": {},
  "attributes": {
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "showCaption": {
      "type": "boolean",
      "default": false
    },
    "reduceMaxWidth": {
      "type": "boolean",
      "default": false
    },
    "reduceMarginBottom": {
      "type": "boolean",
      "default": false
    },
    "videoUrl": {
      "type": "string",
      "regex": "https?:\\/\\/(www\\.)?[-a-zA-Z0-9@:%._\\+~#=]{1,256}\\.[a-zA-Z0-9()]{1,6}\\b([-a-zA-Z0-9()@:%_\\+.~#?&//=]*)"
    },
    "videoStill": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "files",
        "images"
      ]
    },
    "identifier": {
      "type": "string",
      "unique": true
    }
  },
  "config": {}
}
