{
  "collectionName": "components_common_buttons",
  "info": {
    "displayName": "Button",
    "icon": "cursor"
  },
  "options": {},
  "attributes": {
    "displayText": {
      "type": "string",
      "required": true
    },
    "url": {
      "type": "string",
      "required": true,
      "regex": "https?:\\/\\/(www\\.)?[-a-zA-Z0-9@:%._\\+~#=]{1,256}\\.[a-zA-Z0-9()]{1,6}\\b([-a-zA-Z0-9()@:%_\\+.~#?&//=]*)"
    },
    "icon": {
      "type": "customField",
      "customField": "plugin::icon-field.icon",
      "options": {
        "addColorSelector": false,
        "addSizeSelector": false
      }
    },
    "iconPosition": {
      "type": "enumeration",
      "default": "Left",
      "enum": [
        "Left",
        "Right"
      ]
    }
  },
  "config": {}
}
